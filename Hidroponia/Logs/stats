update estadistica_hora set estadistica_hora.17=Format((select avg(valor) from monitoreo_sensor where id_sensor=(select id from sensor where tipo='humedad_ambiente' and sistema=1) and fecha=CURDATE() and hora like '17%'),2) where fecha=curdate() and tipo='humedad_ambiente' and sistema=1
